model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["balances","expense_shares","expenses","payments","travelers","trips","Metrics"]

ref table trips
ref table balances
ref table expense_shares
ref table expenses
ref table payments
ref table travelers
ref table Metrics

ref cultureInfo en-US

