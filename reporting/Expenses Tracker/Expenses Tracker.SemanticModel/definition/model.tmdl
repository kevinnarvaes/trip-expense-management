model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["dim_trips","dim_travelers","fact_expense_shares","fact_payments","fact_balances","Metrics"]

ref table dim_trips
ref table dim_travelers
ref table fact_expense_shares
ref table fact_payments
ref table fact_balances
ref table Metrics

ref cultureInfo en-US

expression p_gold_folder = "C:\\GitHub\\trip-expense-management\\data-pipelines\\database\\gold" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

