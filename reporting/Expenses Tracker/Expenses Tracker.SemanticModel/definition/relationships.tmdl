relationship DimTripsFactExpenseShares
	fromColumn: fact_expense_shares.trip_id
	toColumn: dim_trips.trip_id

relationship DimTripsFactPayments
	fromColumn: fact_payments.trip_id
	toColumn: dim_trips.trip_id

relationship DimTripsFactBalances
	fromColumn: fact_balances.trip_id
	toColumn: dim_trips.trip_id

relationship DimTravelersFactExpenseShares
	fromColumn: fact_expense_shares.traveler_id
	toColumn: dim_travelers.traveler_id

relationship DimTravelersFactPaymentsDebtor
	fromColumn: fact_payments.debtor_traveler_id
	toColumn: dim_travelers.traveler_id

relationship DimTravelersFactBalances
	fromColumn: fact_balances.traveler_id
	toColumn: dim_travelers.traveler_id

relationship DimTravelersFactExpenseSharesLender
	fromColumn: fact_expense_shares.lender_traveler_id
	toColumn: dim_travelers.traveler_id
	isActive: false

relationship DimTravelersFactPaymentsLender
	fromColumn: fact_payments.lender_traveler_id
	toColumn: dim_travelers.traveler_id
	isActive: false

